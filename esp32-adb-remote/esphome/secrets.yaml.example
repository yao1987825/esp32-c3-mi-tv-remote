# ESPHome secrets —— **这个文件不会进 Git 仓库**（已在 .gitignore 里）。
#
# 用法：
#     cp secrets.yaml.example secrets.yaml
# 然后把下面每个值改成你自己的，再编译。
#
# 仓库里只保留 secrets.yaml.example，所以 clone 下来的人必须自己填一份。

# --- WiFi ---
# 板子要连的 WiFi（必须和电视在**同一个网段**，电视靠 WiFi 才认得它）
wifi_ssid: "你的WiFi名字"
wifi_password: "你的WiFi密码"

# --- 板子自己的账号 ---
# OTA 升级密码、web server 密码：随便起一个，记住就行
ota_password: "改成你自己的"
web_password: "改成你自己的"

# --- Home Assistant 原生 API 加密密钥 ---
# 32 字节 base64。生成一条：
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
#
# ★ 这把密钥等于板子的身份凭证，泄露了别人就能连上你的板子，别提交进仓库 ★
api_encryption_key: "把上面命令生成的 base64 粘到这里"
